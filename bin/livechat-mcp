#!/usr/bin/env bash
# livechat-mcp — install and configure the livechat MCP server for one or
# more AI coding assistants.
#
# Supported hosts: Claude Code, Codex CLI, Gemini CLI.
#
# Subcommands:
#   setup          Interactive wizard: pick host(s), install, tune env vars
#   show           Print the env block(s) of every configured host
#   set KEY VALUE  Set one env var across all configured hosts
#   unset KEY      Remove one env var across all configured hosts
#   get KEY        Print the value of one env var (first host with it)
#   help           Show usage

set -eu

# --- terminal styling -------------------------------------------------------

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B=$'\033[1m'; D=$'\033[2m'; I=$'\033[3m'; R=$'\033[0m'
  RED=$'\033[31m'; GREEN=$'\033[32m'; YEL=$'\033[33m'
  BLU=$'\033[34m'; MAG=$'\033[35m'; CYN=$'\033[36m'
else
  B=""; D=""; I=""; R=""
  RED=""; GREEN=""; YEL=""; BLU=""; MAG=""; CYN=""
fi

CHECK="${GREEN}✓${R}"
CROSS="${RED}✗${R}"
ARROW="${CYN}❯${R}"
DOT="${D}·${R}"

# --- paths ------------------------------------------------------------------

CLAUDE_CONFIG="${LIVECHAT_CLAUDE_CONFIG:-$HOME/.claude.json}"
CODEX_CONFIG="${LIVECHAT_CODEX_CONFIG:-$HOME/.codex/config.toml}"
GEMINI_CONFIG="${LIVECHAT_GEMINI_CONFIG:-$HOME/.gemini/settings.json}"

CLAUDE_CMDS_DIR="$HOME/.claude/commands"
CODEX_CMDS_DIR="$HOME/.codex/prompts"
CODEX_SKILLS_DIR="$HOME/.codex/skills"
GEMINI_CMDS_DIR="$HOME/.gemini/commands"

SERVER_NAME="livechat"

# python3 may not be on PATH on Windows (the python.org installer ships only
# `python`). Find whichever exists; fall back if neither works.
if command -v python3 >/dev/null 2>&1; then
  PY="python3"
elif command -v python >/dev/null 2>&1; then
  PY="python"
else
  echo "livechat-mcp: Python 3 not found. Install Python 3.10+ and try again." >&2
  exit 1
fi

# --- knob descriptions ------------------------------------------------------

KNOBS=(
  "LIVECHAT_SILENCE_SEC|How long you have to pause before what you said is sent. Lower = snappier; higher = more breathing room mid-thought.|1.5"
  "LIVECHAT_WHISPER_MODEL|Speech-to-text model. Bigger is more accurate but slower. English-only: tiny.en, base.en, small.en, medium.en. Multilingual (drop the .en): tiny, base, small, medium.|base.en"
  "LIVECHAT_WHISPER_LANGUAGE|Spoken language. Use 'en' for English-only (pairs with the default base.en model). Use 'auto' to let Whisper detect per utterance — requires a multilingual model (base, small, etc., without .en). Or force one with a code like 'pt', 'es', 'fr', 'de'.|en"
  "LIVECHAT_VAD_THRESHOLD|How clearly you have to speak before the mic decides 'this is speech, not noise'. 0.0-1.0. Lower picks up quiet talk but more background noise.|0.5"
  "LIVECHAT_MIN_UTTERANCE_SEC|Ignore anything shorter than this many seconds. Filters coughs and stray noises. Lower if quick yes/no replies get dropped.|0.4"
  "LIVECHAT_LONG_POLL_SEC|How long the server waits in silence for you to speak before pinging the assistant back. Rarely needs changing.|300"
  "LIVECHAT_END_PHRASE|Say this exact phrase out loud to end the voice session. The default is intentionally awkward to avoid collisions.|terminate voice session now"
  "LIVECHAT_DEBUG|Print extra mic/transcription logs (helpful when something feels off). Set to 1 to enable, leave blank for quiet.|"
)

# --- printing helpers -------------------------------------------------------

hr()    { printf "  ${D}────────────────────────────────────────────────${R}\n"; }
title() { printf "\n  ${B}%s${R}\n" "$1"; }
sub()   { printf "  ${D}%s${R}\n" "$1"; }
info()  { printf "    %s %s\n" "$DOT" "$1"; }
ok()    { printf "    %s %s\n" "$CHECK" "$1"; }
warn()  { printf "    ${YEL}!${R} %s\n" "$1"; }
err()   { printf "    %s %s\n" "$CROSS" "$1" >&2; }

usage() {
  cat <<EOF
${B}livechat-mcp${R} — install and tune the livechat MCP server.

${B}Usage:${R} livechat-mcp <command>

${B}Commands:${R}
  ${CYN}setup${R}              Interactive wizard: pick host(s), install, tune env vars
  ${CYN}show${R}               Print the env block(s) of every configured host
  ${CYN}set${R} KEY VALUE      Set one env var across all configured hosts
  ${CYN}unset${R} KEY          Remove one env var across all configured hosts
  ${CYN}get${R} KEY            Print the value of one env var (first host found)
  ${CYN}help${R}               Show this message

${D}Configs read/written:${R}
  Claude Code  $CLAUDE_CONFIG
  Codex CLI    $CODEX_CONFIG
  Gemini CLI   $GEMINI_CONFIG

After making changes, restart your assistant CLI for them to take effect.
EOF
}

# --- python helper ----------------------------------------------------------
# Handles JSON (Claude / Gemini) and TOML (Codex) read/write.

_py() {
  CLAUDE_CONFIG="$CLAUDE_CONFIG" \
  CODEX_CONFIG="$CODEX_CONFIG" \
  GEMINI_CONFIG="$GEMINI_CONFIG" \
  SERVER_NAME="$SERVER_NAME" \
  "$PY" - "$@" <<'PY'
import json, os, re, sys

CLAUDE_CONFIG = os.path.expanduser(os.environ["CLAUDE_CONFIG"])
CODEX_CONFIG = os.path.expanduser(os.environ["CODEX_CONFIG"])
GEMINI_CONFIG = os.path.expanduser(os.environ["GEMINI_CONFIG"])
SERVER = os.environ["SERVER_NAME"]


def _json_load(path):
    if not os.path.exists(path):
        return None
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return None


def _json_save(path, cfg):
    d = os.path.dirname(path)
    if d:
        os.makedirs(d, exist_ok=True)
    tmp = path + ".livechat-mcp.tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)


# ---------- Claude (JSON; possibly multiple entries) ----------

def claude_iter():
    cfg = _json_load(CLAUDE_CONFIG)
    if cfg is None:
        return []
    out = []
    if SERVER in (cfg.get("mcpServers") or {}):
        out.append(("claude:global", cfg, ("mcpServers", SERVER)))
    for proj_path, proj in (cfg.get("projects") or {}).items():
        if isinstance(proj, dict) and SERVER in (proj.get("mcpServers") or {}):
            out.append((f"claude:project:{proj_path}", cfg,
                        ("projects", proj_path, "mcpServers", SERVER)))
    return out


def _resolve(cfg, path):
    d = cfg
    for k in path[:-1]:
        d = d[k]
    return d, path[-1]


def claude_entries():
    return [(label, _resolve(cfg, path)[0][_resolve(cfg, path)[1]])
            for label, cfg, path in claude_iter()]


def claude_add(project_path):
    cfg = _json_load(CLAUDE_CONFIG) or {}
    servers = cfg.setdefault("mcpServers", {})
    existing = servers.get(SERVER) or {}
    env = existing.get("env") or {}
    entry = {
        "command": "uv",
        "args": ["--directory", project_path, "run", "livechat-mcp"],
    }
    if env:
        entry["env"] = env
    servers[SERVER] = entry
    _json_save(CLAUDE_CONFIG, cfg)


def claude_set_env(key, value):
    its = claude_iter()
    if not its:
        return False
    cfg = its[0][1]
    for _, _, path in its:
        parent, last = _resolve(cfg, path)
        parent[last].setdefault("env", {})[key] = value
    _json_save(CLAUDE_CONFIG, cfg)
    return True


def claude_unset_env(key):
    its = claude_iter()
    if not its:
        return False
    cfg = its[0][1]
    removed = False
    for _, _, path in its:
        parent, last = _resolve(cfg, path)
        env = parent[last].get("env") or {}
        if key in env:
            del env[key]
            removed = True
    if removed:
        _json_save(CLAUDE_CONFIG, cfg)
    return removed


# ---------- Gemini (JSON, single entry) ----------

def gemini_entry():
    cfg = _json_load(GEMINI_CONFIG)
    if cfg is None:
        return None
    return (cfg.get("mcpServers") or {}).get(SERVER)


def gemini_add(project_path):
    cfg = _json_load(GEMINI_CONFIG) or {}
    servers = cfg.setdefault("mcpServers", {})
    existing = servers.get(SERVER) or {}
    env = existing.get("env") or {}
    entry = {
        "command": "uv",
        "args": ["--directory", project_path, "run", "livechat-mcp"],
    }
    if env:
        entry["env"] = env
    servers[SERVER] = entry
    _json_save(GEMINI_CONFIG, cfg)


def gemini_set_env(key, value):
    cfg = _json_load(GEMINI_CONFIG)
    if cfg is None:
        return False
    entry = (cfg.get("mcpServers") or {}).get(SERVER)
    if entry is None:
        return False
    entry.setdefault("env", {})[key] = value
    _json_save(GEMINI_CONFIG, cfg)
    return True


def gemini_unset_env(key):
    cfg = _json_load(GEMINI_CONFIG)
    if cfg is None:
        return False
    entry = (cfg.get("mcpServers") or {}).get(SERVER)
    if entry is None:
        return False
    env = entry.get("env") or {}
    if key not in env:
        return False
    del env[key]
    _json_save(GEMINI_CONFIG, cfg)
    return True


# ---------- Codex (TOML, hand-rolled section replacement) ----------

def _toml_string(s):
    return '"' + str(s).replace("\\", "\\\\").replace('"', '\\"') + '"'


def _codex_load_text():
    if not os.path.exists(CODEX_CONFIG):
        return ""
    with open(CODEX_CONFIG) as f:
        return f.read()


def _codex_save_text(text):
    d = os.path.dirname(CODEX_CONFIG)
    if d:
        os.makedirs(d, exist_ok=True)
    tmp = CODEX_CONFIG + ".livechat-mcp.tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, CODEX_CONFIG)


def _codex_parse():
    text = _codex_load_text()
    if not text:
        return None
    try:
        import tomllib  # py3.11+
    except ImportError:
        try:
            import tomli as tomllib  # type: ignore
        except ImportError:
            return None
    try:
        data = tomllib.loads(text)
    except Exception:
        return None
    return (data.get("mcp_servers") or {}).get(SERVER)


def _codex_render(command, args, env):
    out = [f"[mcp_servers.{SERVER}]"]
    out.append(f"command = {_toml_string(command)}")
    args_str = "[" + ", ".join(_toml_string(a) for a in args) + "]"
    out.append(f"args = {args_str}")
    if env:
        out.append("")
        out.append(f"[mcp_servers.{SERVER}.env]")
        for k in sorted(env):
            out.append(f"{k} = {_toml_string(env[k])}")
    return "\n".join(out) + "\n"


def _codex_strip(text):
    pat = re.compile(
        r"(?ms)^\[mcp_servers\." + re.escape(SERVER) + r"(?:\.[^\]]+)?\]"
        r".*?"
        r"(?=^\[|\Z)"
    )
    return pat.sub("", text)


def _codex_write(command, args, env):
    text = _codex_load_text()
    text = _codex_strip(text)
    text = text.rstrip()
    if text:
        text += "\n\n"
    text += _codex_render(command, args, env)
    _codex_save_text(text)


def codex_entry():
    return _codex_parse()


def codex_add(project_path):
    existing = _codex_parse() or {}
    env = existing.get("env") or {}
    _codex_write("uv", ["--directory", project_path, "run", "livechat-mcp"], env)


def codex_set_env(key, value):
    e = _codex_parse()
    if e is None:
        return False
    env = (e.get("env") or {}).copy()
    env[key] = value
    _codex_write(e.get("command", "uv"), e.get("args", []), env)
    return True


def codex_unset_env(key):
    e = _codex_parse()
    if e is None:
        return False
    env = (e.get("env") or {}).copy()
    if key not in env:
        return False
    del env[key]
    _codex_write(e.get("command", "uv"), e.get("args", []), env)
    return True


# ---------- uninstall (remove MCP entry only; bash side handles command files) ----------

def claude_remove():
    cfg = _json_load(CLAUDE_CONFIG)
    if cfg is None:
        return False
    changed = False
    if SERVER in (cfg.get("mcpServers") or {}):
        del cfg["mcpServers"][SERVER]
        changed = True
    for proj in (cfg.get("projects") or {}).values():
        if isinstance(proj, dict) and SERVER in (proj.get("mcpServers") or {}):
            del proj["mcpServers"][SERVER]
            changed = True
    if changed:
        _json_save(CLAUDE_CONFIG, cfg)
    return changed


def codex_remove():
    text = _codex_load_text()
    if not text:
        return False
    new_text = _codex_strip(text).rstrip()
    if new_text == text.rstrip():
        return False
    if new_text:
        new_text += "\n"
    _codex_save_text(new_text)
    return True


def gemini_remove():
    cfg = _json_load(GEMINI_CONFIG)
    if cfg is None:
        return False
    if SERVER not in (cfg.get("mcpServers") or {}):
        return False
    del cfg["mcpServers"][SERVER]
    _json_save(GEMINI_CONFIG, cfg)
    return True


# ---------- ops ----------

def cmd_show():
    found = False
    for label, entry in claude_entries():
        found = True
        print(f"--- {label} ---")
        env = entry.get("env") or {}
        if not env:
            print("(no env vars set)")
        else:
            for k in sorted(env):
                print(f"{k}={env[k]}")
    e = _codex_parse()
    if e is not None:
        found = True
        print("--- codex:global ---")
        env = e.get("env") or {}
        if not env:
            print("(no env vars set)")
        else:
            for k in sorted(env):
                print(f"{k}={env[k]}")
    e = gemini_entry()
    if e is not None:
        found = True
        print("--- gemini:global ---")
        env = e.get("env") or {}
        if not env:
            print("(no env vars set)")
        else:
            for k in sorted(env):
                print(f"{k}={env[k]}")
    if not found:
        sys.stderr.write("livechat-mcp: no livechat MCP entry found in any host config.\n")
        sys.stderr.write("Run 'livechat-mcp setup' first.\n")
        sys.exit(1)


def cmd_set(key, value):
    a = claude_set_env(key, value)
    b = codex_set_env(key, value)
    c = gemini_set_env(key, value)
    if not (a or b or c):
        sys.stderr.write("livechat-mcp: no host config has a livechat entry. "
                         "Run 'livechat-mcp setup' first.\n")
        sys.exit(1)


def cmd_unset(key):
    claude_unset_env(key)
    codex_unset_env(key)
    gemini_unset_env(key)


def cmd_get(key):
    for _, entry in claude_entries():
        env = entry.get("env") or {}
        if key in env:
            print(env[key]); return
    e = _codex_parse()
    if e and key in (e.get("env") or {}):
        print(e["env"][key]); return
    e = gemini_entry()
    if e and key in (e.get("env") or {}):
        print(e["env"][key]); return


def cmd_check(host):
    if host == "claude":
        sys.exit(0 if claude_entries() else 1)
    if host == "codex":
        sys.exit(0 if _codex_parse() is not None else 1)
    if host == "gemini":
        sys.exit(0 if gemini_entry() is not None else 1)
    sys.exit(2)


def cmd_install(host, project_path):
    if host == "claude":
        claude_add(project_path)
    elif host == "codex":
        codex_add(project_path)
    elif host == "gemini":
        gemini_add(project_path)
    else:
        sys.stderr.write(f"unknown host: {host}\n"); sys.exit(2)


def cmd_uninstall(host):
    if host == "claude":
        claude_remove()
    elif host == "codex":
        codex_remove()
    elif host == "gemini":
        gemini_remove()
    else:
        sys.stderr.write(f"unknown host: {host}\n"); sys.exit(2)


def cmd_project_path():
    candidates = []
    for _, entry in claude_entries():
        candidates.append(entry.get("args") or [])
    e = _codex_parse()
    if e:
        candidates.append(e.get("args") or [])
    e = gemini_entry()
    if e:
        candidates.append(e.get("args") or [])
    for args in candidates:
        if "--directory" in args:
            i = args.index("--directory")
            if i + 1 < len(args):
                print(args[i + 1])
                return


op = sys.argv[1] if len(sys.argv) > 1 else ""
if op == "show":
    cmd_show()
elif op == "set":
    cmd_set(sys.argv[2], sys.argv[3])
elif op == "unset":
    cmd_unset(sys.argv[2])
elif op == "get":
    cmd_get(sys.argv[2])
elif op == "check":
    cmd_check(sys.argv[2])
elif op == "install":
    cmd_install(sys.argv[2], sys.argv[3])
elif op == "uninstall":
    cmd_uninstall(sys.argv[2])
elif op == "project_path":
    cmd_project_path()
else:
    sys.stderr.write(f"livechat-mcp: unknown internal op: {op}\n"); sys.exit(2)
PY
}

# --- bash command implementations -------------------------------------------

cmd_show()  { _py show; }

cmd_set() {
  if _py set "$1" "$2"; then
    ok "Set ${B}$1${R}=${B}$2${R} in all configured hosts."
    info "Restart your assistant CLI to apply."
  fi
}

cmd_unset() {
  _py unset "$1"
  ok "Unset ${B}$1${R} where present."
  info "Restart your assistant CLI to apply."
}

cmd_get() { _py get "$1"; }

_is_installed() {
  _py check "$1" 2>/dev/null
}

_command_exists() {
  command -v "$1" >/dev/null 2>&1
}

_resolve_project_path() {
  if [ -n "${LIVECHAT_PROJECT_DIR:-}" ] && [ -f "${LIVECHAT_PROJECT_DIR}/pyproject.toml" ]; then
    echo "$LIVECHAT_PROJECT_DIR"
    return
  fi
  local existing
  existing=$(_py project_path 2>/dev/null || true)
  if [ -n "$existing" ] && [ -f "$existing/pyproject.toml" ]; then
    echo "$existing"
    return
  fi
  if [ -f "$(pwd)/pyproject.toml" ]; then
    echo "$(pwd)"
    return
  fi
  local script_dir
  script_dir="$(cd "$(dirname "$0")" && pwd)"
  if [ -f "$script_dir/../pyproject.toml" ]; then
    (cd "$script_dir/.." && pwd)
    return
  fi
  echo "$(pwd)"
}

_install_md_commands() {
  # $1 = source dir, $2 = dest dir
  local src="$1" dst="$2"
  mkdir -p "$dst"
  cp "$src/livechat.md" "$dst/"
  cp "$src/endlivechat.md" "$dst/"
}

_install_codex_skill() {
  # $1 = project path
  local project_path="$1"
  local src="$project_path/skills/livechat"
  local dst="$CODEX_SKILLS_DIR/livechat"
  if [ ! -f "$src/SKILL.md" ]; then
    warn "Codex skill source missing at $src/SKILL.md"
    return
  fi
  mkdir -p "$dst"
  cp "$src/SKILL.md" "$dst/"
}

_install_gemini_commands() {
  # Convert .md (frontmatter + body) → Gemini's TOML custom-command format.
  local src="$1" dst="$2"
  mkdir -p "$dst"
  "$PY" - "$src" "$dst" <<'PY'
import os, re, sys
src, dst = sys.argv[1], sys.argv[2]
def convert(name):
    with open(os.path.join(src, name + ".md")) as f:
        text = f.read()
    desc = ""
    body = text
    m = re.match(r"^---\s*\n(.*?)\n---\s*\n(.*)$", text, re.DOTALL)
    if m:
        front, body = m.group(1), m.group(2).lstrip("\n")
        for line in front.splitlines():
            if line.startswith("description:"):
                desc = line.split(":", 1)[1].strip()
    body = body.replace('"""', '\\"\\"\\"')
    out = []
    if desc:
        out.append('description = "' + desc.replace('"', '\\"') + '"')
    out.append('prompt = """')
    out.append(body.rstrip())
    out.append('"""')
    with open(os.path.join(dst, name + ".toml"), "w") as f:
        f.write("\n".join(out) + "\n")
for name in ("livechat", "endlivechat"):
    convert(name)
PY
}

_install_host() {
  local host="$1" path="$2" src="$3"
  case "$host" in
    claude)
      _install_md_commands "$src" "$CLAUDE_CMDS_DIR"
      ok "Slash commands → ${D}~/.claude/commands/${R}"
      _py install claude "$path"
      ok "MCP server → ${D}~/.claude.json${R}"
      ;;
    codex)
      _install_md_commands "$src" "$CODEX_CMDS_DIR"
      ok "Legacy prompt files → ${D}~/.codex/prompts/${R}"
      _install_codex_skill "$path"
      ok "Codex skill → ${D}~/.codex/skills/livechat/${R}"
      _py install codex "$path"
      ok "MCP server → ${D}~/.codex/config.toml${R}"
      ;;
    gemini)
      _install_gemini_commands "$src" "$GEMINI_CMDS_DIR"
      ok "Slash commands (TOML) → ${D}~/.gemini/commands/${R}"
      _py install gemini "$path"
      ok "MCP server → ${D}~/.gemini/settings.json${R}"
      ;;
  esac
}

_uninstall_host() {
  local host="$1"
  case "$host" in
    claude)
      rm -f "$CLAUDE_CMDS_DIR/livechat.md" "$CLAUDE_CMDS_DIR/endlivechat.md"
      ok "Slash commands removed from ${D}~/.claude/commands/${R}"
      _py uninstall claude
      ok "MCP server removed from ${D}~/.claude.json${R}"
      ;;
    codex)
      rm -f "$CODEX_CMDS_DIR/livechat.md" "$CODEX_CMDS_DIR/endlivechat.md"
      ok "Prompt files removed from ${D}~/.codex/prompts/${R}"
      rm -rf "$CODEX_SKILLS_DIR/livechat"
      ok "Skill removed from ${D}~/.codex/skills/livechat/${R}"
      _py uninstall codex
      ok "MCP server removed from ${D}~/.codex/config.toml${R}"
      ;;
    gemini)
      rm -f "$GEMINI_CMDS_DIR/livechat.toml" "$GEMINI_CMDS_DIR/endlivechat.toml"
      ok "Slash commands removed from ${D}~/.gemini/commands/${R}"
      _py uninstall gemini
      ok "MCP server removed from ${D}~/.gemini/settings.json${R}"
      ;;
  esac
}

_print_host_row() {
  # Numeric fallback row (used when TTY is unavailable or LIVECHAT_NO_TUI is set).
  local n="$1" name="$2" selected="$3" installed="$4" cli="$5"
  local mark
  if [ "$selected" = "true" ]; then mark="[${GREEN}x${R}]"; else mark="[ ]"; fi
  local hint=""
  if [ "$installed" = "true" ]; then
    hint="${GREEN}already installed${R}"
  elif [ "$cli" = "true" ]; then
    hint="${D}CLI detected${R}"
  else
    hint="${D}CLI not detected${R}"
  fi
  printf "      %s ${CYN}%s)${R} %-13s %s\n" "$mark" "$n" "$name" "$hint"
}

_draw_tui_row() {
  # idx, label, sel, installed, cli, current, label_width
  local idx="$1" label="$2" sel="$3" installed="$4" cli="$5" current="$6" w="$7"
  local mark cursor hint
  if [ "$sel" = "true" ]; then mark="[${GREEN}x${R}]"; else mark="[ ]"; fi
  if [ "$idx" = "$current" ]; then cursor="${CYN}❯${R} "; else cursor="  "; fi
  if [ "$installed" = "true" ]; then
    hint="${GREEN}already installed${R}"
  elif [ "$cli" = "true" ]; then
    hint="${D}CLI detected${R}"
  else
    hint="${D}CLI not detected${R}"
  fi
  printf "      %s%s %-${w}s %s\033[K\n" "$cursor" "$mark" "$label" "$hint"
}

_cursor_select_hosts() {
  # Args:
  #   $1..$3 = sel_claude  sel_codex  sel_gemini   (initial true/false)
  #   $4..$6 = has_claude  has_codex  has_gemini   (already-installed)
  #   $7..$9 = cli_claude  cli_codex  cli_gemini   (CLI detected)
  # Output (globals): SEL_CLAUDE, SEL_CODEX, SEL_GEMINI
  # Returns 0 on confirm, 1 on quit/abort.
  local s0="$1" s1="$2" s2="$3"
  local i0="$4" i1="$5" i2="$6"
  local c0="$7" c1="$8" c2="$9"
  local current=0
  local n=3
  local label_w=11

  printf "      ${D}↑/↓ move · space toggle · a all/none · enter confirm · q quit${R}\n\n"

  # Save the terminal mode so we can restore it on any exit path. Switch to
  # non-canonical mode (each byte returned to read() immediately, no echo).
  local _lc_stty_orig=""
  _lc_stty_orig=$(stty -g < /dev/tty 2>/dev/null) || true

  # Defined as a regular function so signal traps can call it cleanly.
  _livechat_tui_restore() {
    if [ -n "${_lc_stty_orig:-}" ]; then
      stty "$_lc_stty_orig" < /dev/tty 2>/dev/null || true
    fi
    printf "\033[?25h"
  }

  # On Ctrl+C / SIGTERM, restore terminal and exit promptly. Without `exit` in
  # the handler, bash 3.2 returns from the `read` and resumes the loop, making
  # the menu uninterruptible.
  trap '_livechat_tui_restore; exit 130' INT TERM
  trap '_livechat_tui_restore' EXIT

  stty -echo -icanon min 1 time 0 < /dev/tty 2>/dev/null || true
  printf "\033[?25l"

  _redraw() {
    _draw_tui_row 0 "Claude Code" "$s0" "$i0" "$c0" "$current" "$label_w"
    _draw_tui_row 1 "Codex CLI"   "$s1" "$i1" "$c1" "$current" "$label_w"
    _draw_tui_row 2 "Gemini CLI"  "$s2" "$i2" "$c2" "$current" "$label_w"
  }
  _redraw

  local key rest
  while true; do
    key=""
    rest=""
    if ! IFS= read -r -n 1 key < /dev/tty 2>/dev/null; then
      break
    fi

    if [ "$key" = $'\e' ]; then
      # Read the rest of the escape sequence. `-t 1` (integer second) works on
      # both bash 3.2 and 5.x; real escape sequences arrive within microseconds,
      # so the timeout only kicks in for bare-ESC presses.
      IFS= read -r -n 2 -t 1 rest < /dev/tty 2>/dev/null || true
      key="${key}${rest}"
    fi

    case "$key" in
      $'\e[A'|$'\eOA')
        current=$(( (current - 1 + n) % n ))
        ;;
      $'\e[B'|$'\eOB')
        current=$(( (current + 1) % n ))
        ;;
      ' ')
        case "$current" in
          0) [ "$s0" = "true" ] && s0=false || s0=true ;;
          1) [ "$s1" = "true" ] && s1=false || s1=true ;;
          2) [ "$s2" = "true" ] && s2=false || s2=true ;;
        esac
        ;;
      a|A)
        if [ "$s0" = "true" ] && [ "$s1" = "true" ] && [ "$s2" = "true" ]; then
          s0=false; s1=false; s2=false
        else
          s0=true; s1=true; s2=true
        fi
        ;;
      "")
        # Enter — `read -n 1` returns empty when the byte is a newline.
        break
        ;;
      q|Q)
        trap - INT TERM EXIT
        _livechat_tui_restore
        return 1
        ;;
    esac

    printf "\033[${n}A"
    _redraw
  done

  trap - INT TERM EXIT
  _livechat_tui_restore

  SEL_CLAUDE="$s0"
  SEL_CODEX="$s1"
  SEL_GEMINI="$s2"
  return 0
}

# --- setup wizard -----------------------------------------------------------

cmd_setup() {
  printf "\n"
  printf "  ${B}livechat${R}  ${D}— voice MCP setup wizard${R}\n"
  hr
  printf "  ${D}Installs the livechat MCP server for the AI assistant(s) you choose,${R}\n"
  printf "  ${D}then walks you through tuning the env knobs.${R}\n"

  # === Step 1 — pick hosts ===
  title "Step 1 of 3 — pick your assistant(s)"
  printf "\n"

  local has_claude_cli=false has_codex_cli=false has_gemini_cli=false
  if _command_exists claude; then has_claude_cli=true; fi
  if _command_exists codex; then has_codex_cli=true; fi
  if _command_exists gemini; then has_gemini_cli=true; fi

  local has_claude=false has_codex=false has_gemini=false
  if _is_installed claude; then has_claude=true; fi
  if _is_installed codex; then has_codex=true; fi
  if _is_installed gemini; then has_gemini=true; fi

  # Defaults: pre-check installed hosts, otherwise CLIs that are present.
  local default_claude=$has_claude default_codex=$has_codex default_gemini=$has_gemini
  if [ "$has_claude" = false ] && [ "$has_codex" = false ] && [ "$has_gemini" = false ]; then
    default_claude=$has_claude_cli
    default_codex=$has_codex_cli
    default_gemini=$has_gemini_cli
  fi

  local sel_claude sel_codex sel_gemini
  if [ -t 1 ] && [ -e /dev/tty ] && [ -z "${LIVECHAT_NO_TUI:-}" ]; then
    if _cursor_select_hosts \
        "$default_claude" "$default_codex" "$default_gemini" \
        "$has_claude" "$has_codex" "$has_gemini" \
        "$has_claude_cli" "$has_codex_cli" "$has_gemini_cli"; then
      sel_claude="$SEL_CLAUDE"
      sel_codex="$SEL_CODEX"
      sel_gemini="$SEL_GEMINI"
    else
      printf "\n"; err "Aborted."; exit 1
    fi
  else
    # Numeric fallback for non-TTY environments.
    _print_host_row 1 "Claude Code" "$default_claude" "$has_claude" "$has_claude_cli"
    _print_host_row 2 "Codex CLI"   "$default_codex"  "$has_codex"  "$has_codex_cli"
    _print_host_row 3 "Gemini CLI"  "$default_gemini" "$has_gemini" "$has_gemini_cli"
    printf "\n"
    printf "    ${D}Type numbers to toggle (e.g. ${R}${B}1 3${R}${D}), ${R}${B}a${R}${D} for all, ${R}${B}n${R}${D} for none,${R}\n"
    printf "    ${D}or just press ${R}${B}Enter${R}${D} to accept the [x] selections above.${R}\n"
    printf "\n"
    printf "    %s " "$ARROW"
    local selection
    if ! IFS= read -r selection; then
      echo; err "Aborted."; exit 1
    fi

    sel_claude=$default_claude
    sel_codex=$default_codex
    sel_gemini=$default_gemini
    local trimmed
    trimmed=$(echo "$selection" | tr '[:upper:]' '[:lower:]' | tr -d ' ')
    case "$trimmed" in
      "")          ;; # keep defaults
      a|all)       sel_claude=true; sel_codex=true; sel_gemini=true ;;
      n|none)      sel_claude=false; sel_codex=false; sel_gemini=false ;;
      *)
        sel_claude=false; sel_codex=false; sel_gemini=false
        for n in $selection; do
          case "$n" in
            1) sel_claude=true ;;
            2) sel_codex=true ;;
            3) sel_gemini=true ;;
            *) warn "Ignoring unknown choice: $n" ;;
          esac
        done
        ;;
    esac
  fi

  # Anything selected? Anything deselected from a previous install?
  local need_install=false need_uninstall=false
  if [ "$sel_claude" = true ] || [ "$sel_codex" = true ] || [ "$sel_gemini" = true ]; then
    need_install=true
  fi
  if { [ "$has_claude" = true ] && [ "$sel_claude" = false ]; } \
     || { [ "$has_codex" = true ] && [ "$sel_codex" = false ]; } \
     || { [ "$has_gemini" = true ] && [ "$sel_gemini" = false ]; }; then
    need_uninstall=true
  fi

  if [ "$need_install" = false ] && [ "$need_uninstall" = false ]; then
    warn "Nothing to do — selections match current state."
  else
    # === Step 2 — apply changes ===
    title "Step 2 of 3 — applying changes"

    # Uninstall first so removals don't get re-clobbered if a host is being reinstalled.
    if [ "$has_claude" = true ] && [ "$sel_claude" = false ]; then
      printf "\n"; sub "Claude Code (removing)"
      _uninstall_host claude
    fi
    if [ "$has_codex" = true ] && [ "$sel_codex" = false ]; then
      printf "\n"; sub "Codex CLI (removing)"
      _uninstall_host codex
    fi
    if [ "$has_gemini" = true ] && [ "$sel_gemini" = false ]; then
      printf "\n"; sub "Gemini CLI (removing)"
      _uninstall_host gemini
    fi

    if [ "$need_install" = true ]; then
      local project_path
      project_path="$(_resolve_project_path)"
      info "Project path: ${B}${project_path}${R}"
      if [ ! -f "$project_path/pyproject.toml" ]; then
        err "No pyproject.toml at $project_path."
        err "Re-run from the livechat-mcp project directory or set LIVECHAT_PROJECT_DIR."
        exit 1
      fi

      local cmds_src="$project_path/commands"

      if [ "$sel_claude" = true ]; then
        printf "\n"; sub "Claude Code"
        _install_host claude "$project_path" "$cmds_src"
      fi
      if [ "$sel_codex" = true ]; then
        printf "\n"; sub "Codex CLI"
        _install_host codex "$project_path" "$cmds_src"
      fi
      if [ "$sel_gemini" = true ]; then
        printf "\n"; sub "Gemini CLI"
        _install_host gemini "$project_path" "$cmds_src"
      fi
    fi
  fi

  # === Step 3 — knobs ===
  title "Step 3 of 3 — tune env vars"
  printf "  ${D}Press ${R}${B}Enter${R}${D} to keep the current/default value. Type ${R}${B}default${R}${D} to reset.${R}\n"

  local entry key desc default cur new
  for entry in "${KNOBS[@]}"; do
    IFS='|' read -r key desc default <<<"$entry"
    cur=$(_py get "$key" 2>/dev/null || true)
    printf "\n"
    printf "    ${B}%s${R}\n" "$key"
    printf "      ${D}%s${R}\n" "$desc"
    if [ -n "$cur" ]; then
      printf "      current: ${CYN}%s${R}   ${D}(default: %s)${R}\n" "$cur" "${default:-<unset>}"
    else
      printf "      default: ${D}%s${R}\n" "${default:-<unset>}"
    fi
    printf "      %s " "$ARROW"
    if ! IFS= read -r new; then
      echo; err "Aborted."; exit 1
    fi
    if [ -z "$new" ]; then
      printf "      ${D}(kept)${R}\n"
    elif [ "$new" = "$default" ] || [ "$new" = "default" ]; then
      _py unset "$key" >/dev/null 2>&1 || true
      printf "      ${D}(reset to default)${R}\n"
    else
      if _py set "$key" "$new" >/dev/null 2>&1; then
        printf "      ${GREEN}set to %s${R}\n" "$new"
      else
        warn "no host config to write to — skipped"
      fi
    fi
  done

  printf "\n"
  hr
  ok "All done. Restart your assistant CLI for changes to take effect."
  printf "\n"
  printf "    ${B}Next:${R} open your assistant CLI and run the slash command:\n"
  if [ "$sel_claude" = true ]; then
    printf "      ${D}Claude Code  →${R} ${CYN}/livechat${R}\n"
  fi
  if [ "$sel_codex" = true ]; then
    printf "      ${D}Codex CLI    →${R} ${CYN}use livechat${R}  ${D}(or ${CYN}/skills${D} → livechat)${R}\n"
  fi
  if [ "$sel_gemini" = true ]; then
    printf "      ${D}Gemini CLI   →${R} ${CYN}/livechat${R}\n"
  fi
  if [ "$sel_codex" = true ]; then
    printf "\n    ${YEL}!${R} Codex only loads skills and MCP servers at startup — quit and relaunch any open sessions.\n"
  fi
  printf "\n"
}

# --- entry point ------------------------------------------------------------

cmd="${1:-help}"
case "$cmd" in
  setup)         cmd_setup ;;
  show|status)   cmd_show ;;
  set)
    if [ $# -lt 3 ]; then echo "usage: livechat-mcp set KEY VALUE" >&2; exit 2; fi
    cmd_set "$2" "$3" ;;
  unset|remove)
    if [ $# -lt 2 ]; then echo "usage: livechat-mcp unset KEY" >&2; exit 2; fi
    cmd_unset "$2" ;;
  get)
    if [ $# -lt 2 ]; then echo "usage: livechat-mcp get KEY" >&2; exit 2; fi
    cmd_get "$2" ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
